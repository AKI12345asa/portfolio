# 腾讯云 COS 配置 —— 复制本文件为 .env 后填写
# 只填这四项，别把 .env 提交到 git（.gitignore 已忽略）

# 访问管理 → API 密钥管理 里的 SecretId / SecretKey
COS_SECRET_ID=
COS_SECRET_KEY=

# 存储桶所在地域，控制台桶列表里能看到，例如 ap-guangzhou / ap-shanghai / ap-beijing
COS_REGION=ap-guangzhou

# 存储桶名称，注意要带 APPID 后缀，例如 portfolio-video-1250000000
COS_BUCKET=

# 演示视频签名链接（含 SecretId，绝不能提交进仓库）
# 用 .\视频工具.cmd sign --key works/xxx.mp4 --days 365 生成后粘在这里
VIDEO_BATTLE_URL=
VIDEO_ARPG_URL=

# 站点域名，部署时由平台提供，本地不用填
# SITE_URL=https://你的域名
