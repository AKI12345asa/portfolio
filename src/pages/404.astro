---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在" description="这个页面不存在。">
  <section class="nf">
    <div class="wrap">
      <p class="nf__code">404</p>
      <h1>页面不存在</h1>
      <p class="nf__text">链接可能失效了，或者这个项目已经被我删掉。</p>
      <div class="nf__actions">
        <a class="btn btn--primary" href="/">回到首页</a>
        <a class="btn btn--ghost" href="/#projects">查看项目</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(4rem, 12vh, 8rem);
  }

  .nf__code {
    font-size: 0.9rem;
    color: var(--fg-3);
    margin-bottom: 0.75rem;
  }

  h1 {
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nf__text {
    max-width: 44ch;
    margin-top: 0.75rem;
    color: var(--fg-2);
    font-size: 0.95rem;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }
</style>
