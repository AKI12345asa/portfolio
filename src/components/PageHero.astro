---
interface Props {
  title: string;
  lead?: string;
  count?: string;
}

const { title, lead, count } = Astro.props;
---

<section class="page-head">
  <div class="wrap">
    <div class="page-head__row">
      <h1>{title}</h1>
      {count && <span class="page-head__count">{count}</span>}
    </div>
    {lead && <p class="page-head__lead">{lead}</p>}
  </div>
</section>

<style>
  .page-head {
    padding-top: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(1.25rem, 3vw, 2rem);
    border-bottom: 1px solid var(--line);
  }

  .page-head__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  h1 {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .page-head__count {
    font-size: 0.82rem;
    color: var(--fg-3);
  }

  .page-head__lead {
    max-width: 62ch;
    margin-top: 0.85rem;
    color: var(--fg-2);
    font-size: 0.95rem;
    line-height: 1.8;
  }
</style>
